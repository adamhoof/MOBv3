# Catalog service runtime config. No secrets live here.
CATALOG_DB_PATH=/data/catalog.db
CATALOG_HTTP_HOST=0.0.0.0
CATALOG_HTTP_PORT=8443
CATALOG_IMPORT_ENDPOINT=/catalog/import
MQTT_PROTOCOL=tcps
MQTT_HOST=mosquitto_broker
MQTT_PORT=8883
MQTT_CATALOG_CLIENT_ID=catalog_service
MQTT_TOPIC_REQUEST=product/+/+
TLS_CA_PATH=/app/certs/ca.crt
CATALOG_TLS_SERVER_CERT_PATH=/app/certs/catalog_server.crt
CATALOG_TLS_SERVER_KEY_PATH=/run/secrets/mobv3_catalog_server_key
TLS_CLIENT_CERT_PATH=/app/certs/client.crt
TLS_CLIENT_KEY_PATH=/run/secrets/mobv3_client_key
XDG_CACHE_HOME=/data/.cache
