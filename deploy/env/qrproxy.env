# QRProxy deployment and runtime config. No secrets live here.
APP_DIR=/home/adamhoof/MOBv3
HOST_BIND_IP=
WORKDIR=/app
CERT_DIR=/home/adamhoof/MOBv3/certs
CREDENTIAL_DIR=/home/adamhoof/MOBv3/deploy/credentials

GO_IMAGE=docker.io/library/golang:1.26-alpine
TARGETARCH=amd64

PROXY_IP=0.0.0.0
PROXY_PORT=9100
USB_PRINTER=
MQTT_PROTOCOL=tcps
MQTT_HOST=mobv3_mosquitto_broker
MQTT_PORT=8883
QRPROXY_MQTT_CLIENT_ID=qrproxy
QTERM_MQTT_TOPIC=qterm/payments
TLS_CA_PATH=/app/certs/ca.crt
TLS_CLIENT_CERT_PATH=/app/certs/client.crt
TLS_CLIENT_KEY_PATH=/run/secrets/mobv3_client_key
