# QRProxy runtime config. No secrets live here.
PROXY_IP=0.0.0.0
PROXY_PORT=9100
MQTT_PROTOCOL=tcps
MQTT_HOST=mosquitto_broker
MQTT_PORT=8883
QRPROXY_MQTT_CLIENT_ID=qrproxy
QTERM_MQTT_TOPIC=qterm/payments
TLS_CA_PATH=/app/certs/ca.crt
TLS_CLIENT_CERT_PATH=/app/certs/client.crt
TLS_CLIENT_KEY_PATH=/run/secrets/mobv3_client_key
